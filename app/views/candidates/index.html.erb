<%= turbo_frame_tag "elections" do %>
  <%= link_to new_election_candidate_path(@election),
      class: "fixed bottom-6 right-6 flex h-14 w-14 items-center justify-center
              rounded-full bg-[#1B2A4A] text-white shadow-lg
              hover:bg-[#1B2A4A]/90 hover:shadow-xl
              active:scale-95 transition-all duration-150" do %>
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
      <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
    </svg>
  <% end %>

  <%= link_to elections_path,
      class: "fixed bottom-24 right-6 flex h-14 w-14 items-center justify-center
              rounded-full bg-[#1B2A4A] text-white shadow-lg
              hover:bg-[#1B2A4A]/90 hover:shadow-xl
              active:scale-95 transition-all duration-150" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="9 10 4 15 9 20"></polyline>
      <path d="M20 4v7a4 4 0 0 1-4 4H4"></path>
    </svg>
  <% end %>

  <div class="mx-2 mb-6 mt-2">
    <h1 class="text-2xl font-bold text-[#1B2A4A]">
      <%= @election.title %>
    </h1>

    <% if @election.description.present? %>
      <p class="mt-1 text-[#5C6470]">
        <%= @election.description %>
      </p>
    <% end %>

    <% if @has_voted %>
      <div class="mt-4 inline-block rounded-lg bg-[#1E8E5A]/10 border border-[#1E8E5A]/30 px-4 py-2 text-sm font-medium text-[#1E8E5A]">
        ✓ You have already voted in this election.
      </div>
    <% else %>
      <div class="mt-4 inline-block rounded-lg bg-[#E8A33D]/10 border border-[#E8A33D]/30 px-4 py-2 text-sm font-medium text-[#E8A33D]">
        You have not voted yet.
      </div>
    <% end %>
  </div>

  <% if @candidates.any? %>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <% @candidates.each do |candidate| %>
        <div class="mx-2 mt-2 sm:mt-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm hover:shadow-md transition-shadow">

          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="text-lg font-semibold text-[#1B2A4A]">
                <%= candidate.name %>
              </h2>

              <p class="shrink-0 rounded-full -ml-2 px-2 py-1 text-sm font-medium
                        <%= candidate.active? ? 'bg-[#1E8E5A]/10 text-[#1E8E5A]' : 'bg-[#5C6470]/10 text-[#5C6470]' %>">
                Status: <%= candidate.status.capitalize %>
              </p>

              <% if candidate.candidate_number.present? %>
                <p class="mt-1 text-sm text-[#5C6470]">
                  Candidate #<%= candidate.candidate_number %>
                </p>
              <% end %>
            </div>

            <div class="shrink-0">
              <%= image_tag candidate.image,
                  referrerpolicy: "no-referrer",
                  class: "h-16 w-16 sm:h-20 sm:w-20 object-cover rounded-lg border border-gray-200" %>
            </div>

            <div class="flex flex-col gap-2 shrink-0">
              <%= link_to "Edit",
                  edit_election_candidate_path(@election, candidate),
                  class: "rounded-lg border border-[#1B2A4A] px-4 py-2 text-sm font-semibold text-center
                          text-[#1B2A4A] hover:bg-[#1B2A4A]/5 transition-colors" %>
              <% if @has_voted %>
                <span class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-2 text-sm font-semibold text-center text-[#5C6470]">
                  ✓ Already voted
                </span>
              <% else %>
                <%= button_to "Vote",
                    election_votes_path(@election),
                    data: { turbo_method: :post, turbo_frame: "_top", turbo_confirm: "Are you sure you want to vote for #{candidate.name}?" },
                    method: :post,
                    params: { candidate_id: candidate.id },
                    class: "rounded-lg border border-[#1B2A4A] px-4 py-2 text-sm
                            font-semibold text-[#1B2A4A] text-center hover:bg-[#1B2A4A]/5 transition-colors w-full" %>
              <% end %>                            
              
              <% if candidate.active? %>
                <%= button_to "Deactivate",
                    deactivate_election_candidate_path(@election, candidate),
                    data: { turbo_method: :patch, turbo_frame: "_top" },
                    method: :patch,
                    class: "rounded-lg border border-[#C4423A] px-4 py-2 text-sm font-semibold text-center
                            text-[#C4423A] hover:bg-[#C4423A]/5 transition-colors w-full" %>
              <% else %>
                <%= button_to "Activate",
                    activate_election_candidate_path(@election, candidate),
                    data: { turbo_method: :patch, turbo_frame: "_top" },
                    method: :patch,
                    class: "rounded-lg border border-[#1E8E5A] px-4 py-2 text-sm font-semibold text-center
                            text-[#1E8E5A] hover:bg-[#1E8E5A]/5 transition-colors w-full" %>
              <% end %>
            </div>
          </div>

          <% if candidate.short_bio.present? %>
            <p class="mt-4 text-sm text-[#5C6470] line-clamp-3">
              <%= candidate.short_bio %>
            </p>
          <% end %>
        </div>
      <% end %>
    </div>

  <% else %>
    <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center">
      <p class="text-[#5C6470]">
        No candidates have been added to this election yet.
      </p>
    </div>
  <% end %>
<% end %>