<%= turbo_frame_tag "elections" do %>
  <div class="mx-auto max-w-4xl px-6 py-10">

    <div class="mt-4 mb-6">
      <h1 class="text-2xl font-bold text-[#1B2A4A]">
        Add Candidate
      </h1>

      <p class="mt-1 text-[#5C6470]">
        Add a candidate to <b><%= @election.title %></b>
      </p>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <%= render "form", election: @election, candidate: @candidate %>
    </div>
  </div>
<% end %>