<div class="min-h-screen flex justify-center bg-[#FAFAF8] px-4 py-10">
  <div class="w-full max-w-md">

    <!-- Logo / App name -->
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-[#1B2A4A]">VoteApp</h1>
      <p class="text-sm text-[#5C6470] mt-1">Sign in to cast your vote</p>
    </div>

    <!-- Card -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
      <h2 class="text-xl font-semibold text-[#1B2A4A] mb-6">Log in</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>

        <!-- Email -->
        <div class="mb-4">
          <%= f.label :email, class: "block text-sm font-medium text-[#1B2A4A] mb-1" %>
          <%= f.email_field :email,
                autofocus: true,
                autocomplete: "email",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-[#1B2A4A]
                        focus:outline-none focus:ring-2 focus:ring-[#1B2A4A] focus:border-transparent
                        placeholder-gray-400",
                placeholder: "you@example.com" %>
        </div>

        <!-- Password -->
        <div class="mb-2">
          <%= f.label :password, class: "block text-sm font-medium text-[#1B2A4A] mb-1" %>
          <%= f.password_field :password,
                autocomplete: "current-password",
                class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-[#1B2A4A]
                        focus:outline-none focus:ring-2 focus:ring-[#1B2A4A] focus:border-transparent
                        placeholder-gray-400",
                placeholder: "••••••••" %>
        </div>

        <!-- Remember me + forgot password -->
        <div class="flex items-center justify-between mb-6 mt-3">
          <% if devise_mapping.rememberable? %>
            <label class="flex items-center text-sm text-[#5C6470]">
              <%= f.check_box :remember_me, class: "rounded border-gray-300 text-[#1B2A4A] focus:ring-[#1B2A4A] mr-2" %>
              Remember me
            </label>
          <% end %>

          <% if devise_mapping.recoverable? %>
            <%= link_to "Forgot password?", new_password_path(resource_name),
                  class: "text-sm text-[#1B2A4A] hover:underline" %>
          <% end %>
        </div>

        <!-- Error messages -->
        <% if resource.errors.any? %>
          <div class="mb-4 p-3 bg-red-50 border border-[#C4423A]/30 rounded-lg">
            <p class="text-sm text-[#C4423A]">
              Invalid email or password. Please try again.
            </p>
          </div>
        <% end %>

        <!-- Submit -->
        <%= f.submit "Log in",
              class: "w-full bg-[#1B2A4A] hover:bg-[#243a63] text-white font-medium
                      py-2.5 rounded-lg transition-colors cursor-pointer" %>
      <% end %>

      <!-- Links -->
      <div class="mt-6 pt-6 border-t border-gray-100 text-center text-sm text-[#5C6470]">
        <% if devise_mapping.registerable? %>
          <%= link_to "Don't have an account? Sign up", new_registration_path(resource_name),
                class: "text-[#1B2A4A] font-medium hover:underline" %>
        <% end %>
      </div>
    </div>

    <!-- Footer note -->
    <p class="text-center text-xs text-[#5C6470] mt-6">
      Your login is secure and your vote is confidential.
    </p>
  </div>
</div>

<%= render "devise/shared/links" %>
