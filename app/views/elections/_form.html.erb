<div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
    <%= form_with model: @election do |form| %>
        <% if @election.errors.any? %>
            <div class="mb-6 p-3 bg-[#C4423A]/10 border border-[#C4423A]/30 rounded-lg">
                <p class="text-sm font-medium text-[#C4423A] mb-1">
                    <%= pluralize(@election.errors.count, "error") %> prevented this election from being saved:
                </p>
                <ul class="list-disc list-inside text-sm text-[#C4423A]">
                    <% @election.errors.full_messages.each do |message| %>
                        <li><%= message %></li>
                    <% end %>
                </ul>
            </div>
        <% end %>

        <div class="space-y-5">
            <div>
                <%= form.label :title, class: "block text-sm font-medium text-[#1B2A4A] mb-1" %>
                <%= form.text_field :title,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-[#1B2A4A]
                                focus:outline-none focus:ring-2 focus:ring-[#1B2A4A] focus:border-transparent
                                placeholder-gray-400",
                        placeholder: "e.g. 2026 General Election" %>
            </div>

            <div class="mb-1">
                <%= form.label :description, class: "block text-sm font-medium text-[#1B2A4A] mb-1" %>
                <%= form.text_area :description,
                        rows: 5,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-[#1B2A4A]
                                focus:outline-none focus:ring-2 focus:ring-[#1B2A4A] focus:border-transparent
                                placeholder-gray-400 resize-none",
                        placeholder: "Brief description of this election" %>
            </div>

            <div class="mb-1">
                <%= form.label :start_at, class: "block text-sm font-medium text-[#1B2A4A] mb-1" %>
                <%= form.datetime_local_field :start_at,
                        step: 60,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-[#1B2A4A]
                                focus:outline-none focus:ring-2 focus:ring-[#1B2A4A] focus:border-transparent" %>
            </div>

            <div class="mb-1">
                <%= form.label :end_at, class: "block text-sm font-medium text-[#1B2A4A] mb-1" %>
                <%= form.datetime_local_field :end_at,
                        step: 60,
                        class: "w-full px-3 py-2 border border-gray-300 rounded-lg text-[#1B2A4A]
                                focus:outline-none focus:ring-2 focus:ring-[#1B2A4A] focus:border-transparent" %>
            </div>

            <div class="flex items-center gap-3 mt-1">
                <%= form.submit class: "flex-1 bg-[#1B2A4A] hover:bg-[#243a63] text-white font-medium
                                py-2.5 rounded-lg transition-colors cursor-pointer" %>

                <%= link_to "Cancel",
                        elections_path,
                        class: "flex-1 text-center bg-gray-100 hover:bg-gray-200 text-[#1B2A4A]
                                font-medium py-2.5 rounded-lg transition-colors" %>
            </div>
        </div>
    <% end %>
</div>