<%= turbo_frame_tag "elections" do %>
  <div class="min-h-screen bg-[#FAFAF8] px-4 py-10">
    <div class="w-full max-w-2xl mx-auto">

      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-[#1B2A4A]">
          Update Election
        </h1>
      </div>

      <%= render "form", submit_text: "Update Election" %>

      <div class="mt-2 bg-white border border-gray-200 rounded-xl shadow-sm p-8">
          <div class="flex items-center gap-3 mt-1 justify-center">
              <% if @election.active? %>
                  <%= link_to "Deactivate",
                          deactivate_election_path(@election),
                          data: { turbo_method: :patch },
                          class: "flex-1 text-center bg-gray-100 hover:bg-gray-200 text-[#1B2A4A]
                          font-medium py-2.5 rounded-lg transition-colors" %>
              <% else %>
                  <%= link_to "Activate",
                              activate_election_path(@election),
                              data: { turbo_method: :patch },
                              class: "flex-1 text-center bg-[#1B2A4A] hover:bg-[#243a63] text-white font-medium
                              py-2.5 rounded-lg transition-colors cursor-pointer" %>

              <% end %>
          </div>
      </div>
  </div>
<% end %>