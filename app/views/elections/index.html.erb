<%= turbo_frame_tag "elections" do %>
  <div class="mx-auto max-w-6xl px-6 py-10" data-controller="scroll-top">
    <div class="mb-10">
      <div class="flex items-center justify-between">
          <h1 class="text-3xl font-bold text-[#1B2A4A]">Elections</h1>
          <%= link_to "Create",
              new_election_path,
              class: "rounded-lg bg-[#1B2A4A] hover:bg-[#243a63] px-4 py-2 text-sm font-semibold
                      text-white transition-colors" %>
      </div>
      <p class="mt-2 text-[#5C6470]">
        View available elections and their current status.
      </p>
    </div>

    <% if @elections.any? %>
      <div class="space-y-6">
        <% @elections.each do |election| %>
          <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-6">
              <div>
                <h2 class="text-xl font-semibold text-[#1B2A4A]">
                  <%= election.title %>
                </h2>

                <% if election.description.present? %>
                  <p class="mt-2 text-[#5C6470]">
                    <%= election.description %>
                  </p>
                <% end %>
              </div>

              <span class="shrink-0 rounded-full px-3 py-1 text-sm font-medium
                <%= election.active? ? 'bg-[#1E8E5A]/10 text-[#1E8E5A]' : 'bg-[#5C6470]/10 text-[#5C6470]' %>">
                <%= election.state.capitalize %>
              </span>
            </div>

            <div class="mt-6 grid gap-4 text-sm text-[#5C6470] sm:grid-cols-2">
              <div>
                <span class="font-medium text-[#1B2A4A]">Start:</span>
                <%= election.start_at.strftime("%d %B %Y, %H:%M") %>
              </div>

              <div>
                <span class="font-medium text-[#1B2A4A]">End:</span>
                <%= election.end_at.strftime("%d %B %Y, %H:%M") %>
              </div>
            </div>

            <div class="mt-6 flex gap-3">
              <%= link_to "Edit",
                    edit_election_path(election),
                    class: "rounded-lg border border-[#1B2A4A] px-4 py-2 text-sm font-semibold
                            text-[#1B2A4A] hover:bg-[#1B2A4A]/5 transition-colors" %>

              <% if election.active? %>
                <%= button_to "Deactivate",
                      deactivate_election_path(election),
                      method: :patch,
                      class: "rounded-lg border border-[#C4423A] px-4 py-2 text-sm font-semibold
                              text-[#C4423A] hover:bg-[#C4423A]/5 transition-colors cursor-pointer" %>
              <% else %>
                <%= button_to "Activate",
                      activate_election_path(election),
                      method: :patch,
                      class: "rounded-lg bg-[#1E8E5A] px-4 py-2 text-sm font-semibold
                              text-white hover:bg-[#1a7a4d] transition-colors cursor-pointer" %>
              <% end %>
            </div>
          </div>

          <div class="flex gap-3">
            <%= link_to "List Candidates",
                election_candidates_path(election),
                class: "rounded-lg border border-[#1B2A4A] px-4 py-2 text-sm font-semibold text-[#1B2A4A] hover:bg-[#1B2A4A]/5 transition-colors" %>
            
            <%= link_to "Add Candidates",
                new_election_candidate_path(election),
                class: "rounded-lg bg-[#1B2A4A] hover:bg-[#243a63] px-4 py-2 text-sm font-semibold text-white transition-colors" %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-gray-300 p-10 text-center">
        <p class="text-[#5C6470]">
          No elections have been created yet.
        </p>

        <%= link_to "Create Election",
              new_election_path,
              class: "mt-4 inline-block rounded-lg bg-[#1B2A4A] hover:bg-[#243a63]
                      px-5 py-2.5 font-semibold text-white transition-colors" %>
      </div>
    <% end %>
  </div>
<% end %>