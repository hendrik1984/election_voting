<%= turbo_frame_tag "elections" do %>
  <div class="min-h-screen bg-[#FAFAF8] px-4 py-10">
    <div class="w-full max-w-2xl mx-auto">

      <div class="text-center mb-8">
        <h1 class="text-2xl font-bold text-[#1B2A4A]">
          Create Election
        </h1>

        <p class="text-sm text-[#5C6470] mt-1">
          Create a new election and define its basic information.
        </p>
      </div>

      <%= render "form", submit_text: "Create Election" %>
    </div>
  </div>
<% end %>