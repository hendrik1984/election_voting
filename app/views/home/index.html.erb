<div class="min-h-screen bg-[#FAFAF8] px-4 py-10">
  <div class="w-full max-w-2xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold text-[#1B2A4A]">VoteApp</h1>
      <p class="text-sm text-[#5C6470] mt-1">Cast your vote for the <b><%= year_now %></b> General Election</p>
    </div>

    <!-- Card -->
    <div class="bg-white border border-gray-200 rounded-xl shadow-sm p-8">
      <h2 class="text-xl font-semibold text-[#1B2A4A] mb-1">Select a candidate</h2>
      <p class="text-sm text-[#5C6470] mb-6">Choose one. Your selection is final once submitted.</p>
    
    </div>

    <!-- Footer note -->
    <p class="text-center text-xs text-[#5C6470] mt-6">
      Your login is secure and your vote is confidential.
    </p>
  </div>
</div>